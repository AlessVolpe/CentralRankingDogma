+++ b/tests/test_calendar.c
@@ -0,0 +1,176 @@
+/* Public permutation contracts: small leagues, real fixtures, determinism. */
+#include "calendar.h"
+#include "calendar_test_fixture.h"
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(expr) do { if(!(expr)) { fprintf(stderr,"%s:%d: %s\n",__FILE__,__LINE__,#expr); return EXIT_FAILURE; } } while(0)
+
+static int exercise(size_t n,size_t r,calendar_method_t method,
+                    calendar_sampling_mode_t mode) {
+    calendar_test_fixture_t fixture;
+    CHECK(calendar_test_prepare(&fixture,n,r)==0);
+    competition_t *source=NULL;
+    CHECK(competition_create(&fixture.input,&source)==0);
+    calendar_options_t opts=calendar_options_default();
+    opts.method=method;opts.sampling_mode=mode;opts.seed=42U;
+    opts.moves_per_sample=30U;opts.chain_warmup_moves=4U;
+    opts.chain_thinning_moves=3U;
+    calendar_generator_t *first=NULL,*second=NULL;
+    CHECK(calendar_generator_create(source,&opts,&first)==0);
+    CHECK(calendar_generator_create(source,&opts,&second)==0);
+    for(size_t iter=0;iter<15U;++iter) {
+        calendar_t *a=NULL,*b=NULL;
+        calendar_diagnostics_t da,db;
+        CHECK(calendar_generator_next(first,&a,&da)==0 && a!=NULL);
+        CHECK(calendar_generator_next(second,&b,&db)==0 && b!=NULL);
+        CHECK(calendar_validate(source,a)==0 && calendar_validate(source,b)==0);
+        CHECK(calendar_fingerprint(a)==calendar_fingerprint(b));
+        CHECK(memcmp(&da,&db,sizeof(da))==0);
+        CHECK(calendar_team_count(a)==n && calendar_round_count(a)==r);
+        for(size_t i=0;i<r;++i) {
+            uint32_t day;
+            CHECK(calendar_round_matchday(a,i,&day)==0 && day==i+4U);
+            for(size_t j=0;j<n/2U;++j) {
+                fixture_t f;
+                CHECK(calendar_fixture_at(a,i,j,&f)==0);
+                CHECK(f.home<n && f.away<n && f.home!=f.away);
+            }
+        }
+        calendar_destroy(b);
+        if(iter==14U) {
+            /* Output must be independently owned after generator teardown. */
+            calendar_generator_destroy(first);first=NULL;
+            CHECK(calendar_validate(source,a)==0);
+        }
+        calendar_destroy(a);
+    }
+    calendar_generator_destroy(first);calendar_generator_destroy(second);
+    competition_destroy(source);
+    return 0;
+}
+
+static int reject_incompatible(void) {
+    calendar_test_fixture_t f;
+    CHECK(calendar_test_prepare(&f,4U,6U)==0);
+    f.rounds[1].fixtures=f.rounds[0].fixtures;
+    competition_t *source=NULL;
+    CHECK(competition_create(&f.input,&source)==0);
+    calendar_generator_t *generator=(calendar_generator_t*)(uintptr_t)1U;
+    CHECK(calendar_generator_create(source,NULL,&generator)==-ENOTSUP);
+    CHECK(generator==NULL);
+    competition_destroy(source);
+    return 0;
+}
+
+/* Import the literal 10-team/35-round user calendar (including pending dates)
+ * to check the anchored ninth base round and real directed home/away counts. */
+static int real_calendar(void) {
+#ifndef LEADERBOARD_CALENDAR_TSV
+#error "Define LEADERBOARD_CALENDAR_TSV"
+#endif
+    FILE *file=fopen(LEADERBOARD_CALENDAR_TSV,"rb");CHECK(file!=NULL);
+    char ids[10][TEAM_UUID_TEXT_SIZE];
+    char names[10][TEAM_NAME_MAX_BYTES+1];
+    competition_team_input_t teams[10];
+    competition_fixture_input_t matches[35][5];
+    competition_round_input_t rounds[35]={0};
+    competition_score_input_t scores[350]={0};
+    char line[1024];size_t team_count=0U,fixture_count=0U;
+    while(fgets(line,sizeof(line),file)!=NULL) {
+        if(line[0]=='#')continue;
+        unsigned rd,day,p1,p2;char home[256],away[256],stat;
+        CHECK(sscanf(line,"%u\t%u\t%255[^\t]\t%255[^\t]\t%u\t%u\t%c",
+                     &rd,&day,home,away,&p1,&p2,&stat)==7);
+        CHECK(rd>=1U && rd<=35U && team_count<=10U);
+        size_t idx[2];const char *parts[2]={home,away};
+        for(size_t k=0;k<2U;++k) {
+            size_t j=0;
+            for(;j<team_count;++j) if(strcmp(names[j],parts[k])==0) break;
+            if(j==team_count) {
+                CHECK(team_count<10U);
+                (void)snprintf(names[j],sizeof(names[j]),"%s",parts[k]);
+                (void)snprintf(ids[j],sizeof(ids[j]),
+                               "00000000-0000-4000-8000-%012u",(unsigned)(j+1U));
+                teams[j]=(competition_team_input_t){ids[j],names[j]};
+                ++team_count;
+            }
+            idx[k]=j;
+        }
+        size_t rr=(size_t)(rd-1U), fi=rounds[rr].fixture_count;
+        CHECK(fi<5U);
+        matches[rr][fi]=(competition_fixture_input_t){ids[idx[0]],ids[idx[1]]};
+        rounds[rr].fixture_count++;
+        rounds[rr].serie_a_matchday=day;
+        CHECK(stat=='F' || stat=='P');
+        scores[rr*10U+idx[0]]=(competition_score_input_t){ids[idx[0]],day,
+            {p1,stat=='F' ? FANTASY_SCORE_FINAL : FANTASY_SCORE_PENDING}};
+        scores[rr*10U+idx[1]]=(competition_score_input_t){ids[idx[1]],day,
+            {p2,stat=='F' ? FANTASY_SCORE_FINAL : FANTASY_SCORE_PENDING}};
+        fixture_count++;
+    }
+    CHECK(fclose(file)==0 && fixture_count==175U && team_count==10U);
+    for(size_t r=0;r<35U;++r) {
+        CHECK(rounds[r].fixture_count==5U);
+        rounds[r].fixtures=matches[r];
+    }
+    competition_input_t input={teams,10U,rounds,35U,scores,350U};
+    competition_t *source=NULL;
+    CHECK(competition_create(&input,&source)==0);
+    CHECK(!competition_is_simulation_ready(source));
+    for(unsigned method=0;method<2U;++method) {
+        calendar_options_t opts=calendar_options_default();
+        opts.seed=12345U;opts.method=(calendar_method_t)method;
+        opts.moves_per_sample=80U;
+        calendar_generator_t *generator=NULL;
+        CHECK(calendar_generator_create(source,&opts,&generator)==0);
+        size_t changed=0U,three=0U;
+        for(size_t i=0;i<32U;++i) {
+            calendar_t *calendar=NULL;calendar_diagnostics_t info;
+            CHECK(calendar_generator_next(generator,&calendar,&info)==0);
+            CHECK(calendar_validate(source,calendar)==0);
+            fixture_t original[5];
+            for(size_t j=0;j<5U;++j) CHECK(competition_fixture_at(source,8U,j,&original[j])==0);
+            for(size_t j=0;j<5U;++j) {
+                fixture_t candidate;int found=0;
+                CHECK(calendar_fixture_at(calendar,8U,j,&candidate)==0);
+                for(size_t k=0;k<5U;++k)
+                    if((candidate.home==original[k].home && candidate.away==original[k].away) ||
+                       (candidate.home==original[k].away && candidate.away==original[k].home)) found=1;
+                CHECK(found);
+            }
+            if(info.changed_base_rounds) ++changed;
+            three+=(size_t)info.three_round_moves;
+            calendar_destroy(calendar);
+        }
+        CHECK(changed>0U);
+        if(method==CALENDAR_METHOD_RECOMBINE) CHECK(three>0U);
+        calendar_generator_destroy(generator);
+    }
+    competition_destroy(source);
+    return 0;
+}
+
+int main(void) {
+    CHECK(calendar_round_count(NULL)==0U && calendar_team_count(NULL)==0U);
+    CHECK(calendar_fingerprint(NULL)==0U);
+    CHECK(calendar_generator_create(NULL,NULL,NULL)==-EINVAL);
+    calendar_t *calendar=(calendar_t*)(uintptr_t)1U;
+    CHECK(calendar_generator_next(NULL,&calendar,NULL)==-EINVAL && calendar==NULL);
+    calendar_destroy(NULL);calendar_generator_destroy(NULL);
+    CHECK(reject_incompatible()==0);
+    const size_t sizes[]={2U,4U,8U,10U,12U};
+    for(size_t s=0;s<5U;++s) {
+        size_t n=sizes[s],p=n-1U;
+        size_t rounds[4]={p>1U ? p-1U : 1U,p,p*2U,p*3U-1U};
+        for(size_t j=0;j<4U;++j) for(unsigned method=0;method<2U;++method)
+            for(unsigned mode=0;mode<2U;++mode)
+                CHECK(exercise(n,rounds[j],(calendar_method_t)method,
+                               (calendar_sampling_mode_t)mode)==0);
+    }
+    CHECK(real_calendar()==0);
+    return 0;
+}
diff --git a/tests/test_calendar_failures.c b/tests/test_calendar_failures.c
new file mode 100644
index 0000000..3bcace1
--- /dev/null
+++ b/tests/test_calendar_failures.c
@@ -0,0 +1,100 @@
+/* Failure-atomic generator RNG/chain state and adversarial validation. */
+#include "calendar.h"
+#include "calendar_internal.h"
+#include "alloc_internal.h"
+#include "calendar_test_fixture.h"
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(expr) do {if(!(expr)){fprintf(stderr,"%s:%d: %s\n",__FILE__,__LINE__,#expr);return EXIT_FAILURE;}}while(0)
+
+static int failure_matrix(void) {
+    calendar_test_fixture_t f;
+    CHECK(calendar_test_prepare(&f,10U,35U)==0);
+    competition_t *c=NULL;CHECK(competition_create(&f.input,&c)==0);
+    calendar_options_t options=calendar_options_default();
+    options.seed=UINT32_C(0xDEADBEEF);options.moves_per_sample=13U;
+    options.sampling_mode=CALENDAR_SAMPLING_CHAIN;
+    for(size_t cutoff=0U;cutoff<10U;++cutoff) {
+        calendar_generator_t *g=NULL;
+        leaderboard_alloc_fail_after(cutoff);
+        int status=calendar_generator_create(c,&options,&g);
+        leaderboard_alloc_reset();
+        CHECK(status==0 || status==-ENOMEM);
+        if(status==0)calendar_generator_destroy(g);
+        else CHECK(g==NULL);
+    }
+    /* A successful generator must be unchanged by *any* failed next call. */
+    for(size_t cutoff=0U;cutoff<25U;++cutoff) {
+        calendar_generator_t *reference=NULL,*candidate=NULL;
+        CHECK(calendar_generator_create(c,&options,&reference)==0);
+        CHECK(calendar_generator_create(c,&options,&candidate)==0);
+        calendar_t *attempt=NULL;
+        leaderboard_alloc_fail_after(cutoff);
+        int status=calendar_generator_next(candidate,&attempt,NULL);
+        leaderboard_alloc_reset();
+        CHECK(status==0 || status==-ENOMEM);
+        if(status!=0) {
+            CHECK(attempt==NULL);
+            calendar_t *expected=NULL,*received=NULL;
+            CHECK(calendar_generator_next(reference,&expected,NULL)==0);
+            CHECK(calendar_generator_next(candidate,&received,NULL)==0);
+            CHECK(calendar_fingerprint(expected)==calendar_fingerprint(received));
+            calendar_destroy(expected);calendar_destroy(received);
+        } else {
+            CHECK(attempt!=NULL && calendar_validate(c,attempt)==0);
+            calendar_destroy(attempt);
+        }
+        calendar_generator_destroy(candidate);calendar_generator_destroy(reference);
+    }
+    competition_destroy(c);return 0;
+}
+
+static int validation_edges(void) {
+    calendar_test_fixture_t f;
+    CHECK(calendar_test_prepare(&f,8U,20U)==0);
+    competition_t *competition=NULL;CHECK(competition_create(&f.input,&competition)==0);
+    calendar_options_t options=calendar_options_default();
+    calendar_generator_t *g=NULL;CHECK(calendar_generator_create(competition,&options,&g)==0);
+    calendar_t *c=NULL;CHECK(calendar_generator_next(g,&c,NULL)==0);
+    CHECK(calendar_validate(competition,c)==0);
+    fixture_t original=c->fixtures[0];
+    c->fixtures[0]=c->fixtures[1];
+    CHECK(calendar_validate(competition,c)==-EINVAL);
+    c->fixtures[0]=original;
+    c->matchdays[0]++;
+    CHECK(calendar_validate(competition,c)==-EINVAL);
+    c->matchdays[0]--;
+    /* Intact source and candidate must both remain valid. */
+    CHECK(calendar_validate(competition,c)==0);
+    CHECK(calendar_validate(NULL,c)==-EINVAL);
+    CHECK(calendar_validate(competition,NULL)==-EINVAL);
+    /* A changed directed match that keeps the undirected pair still fails. */
+    c->fixtures[0]=(fixture_t){original.away,original.home};
+    CHECK(calendar_validate(competition,c)==-EINVAL);
+    c->fixtures[0]=original;
+    CHECK(calendar_validate(competition,c)==0);
+    /* Public API argument and bounds validation. */
+    CHECK(calendar_fixture_at(c,999U,0U,&original)==-ERANGE);
+    CHECK(calendar_round_matchday(c,999U,NULL)==-EINVAL);
+    CHECK(calendar_round_matchday(c,999U,&(uint32_t){0})==-ERANGE);
+    calendar_destroy(c);
+    calendar_generator_destroy(g);
+    options.method=(calendar_method_t)99;
+    CHECK(calendar_generator_create(competition,&options,&g)==-EINVAL && g==NULL);
+    options=calendar_options_default();options.three_round_node_limit=0U;
+    CHECK(calendar_generator_create(competition,&options,&g)==-EINVAL && g==NULL);
+    options=calendar_options_default();options.three_round_node_limit=1U;
+    CHECK(calendar_generator_create(competition,&options,&g)==0);
+    CHECK(calendar_generator_next(g,&c,NULL)==0);
+    CHECK(calendar_validate(competition,c)==0);
+    calendar_destroy(c);calendar_generator_destroy(g);
+    competition_destroy(competition);return 0;
+}
+int main(void) {
+    CHECK(failure_matrix()==0);
+    CHECK(validation_edges()==0);
+    return 0;
+}
diff --git a/tests/test_calendar_sampling.c b/tests/test_calendar_sampling.c
new file mode 100644
index 0000000..73a37be
--- /dev/null
+++ b/tests/test_calendar_sampling.c
@@ -0,0 +1,92 @@
+/* Deterministic, descriptive sampling diagnostics; NOT a uniformity proof. */
+#include "calendar.h"
+#include "calendar_test_fixture.h"
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(expr) do {if(!(expr)){fprintf(stderr,"%s:%d: %s\n",__FILE__,__LINE__,#expr);return EXIT_FAILURE;}}while(0)
+
+static int small_exact_reference(void) {
+    calendar_test_fixture_t input;
+    CHECK(calendar_test_prepare(&input,4U,3U)==0);
+    competition_t *c=NULL;CHECK(competition_create(&input.input,&c)==0);
+    calendar_options_t options=calendar_options_default();
+    options.method=CALENDAR_METHOD_ROUND_SHUFFLE;
+    options.seed=UINT32_C(1301);
+    calendar_generator_t *generator=NULL;
+    CHECK(calendar_generator_create(c,&options,&generator)==0);
+    /* A K4 first cycle has precisely three perfect matchings. Reordering
+     * them produces exactly 3!=6 distinct labeled round sequences. */
+    enum { SAMPLE_COUNT=6000, POSSIBILITIES=6 };
+    uint64_t fingerprints[POSSIBILITIES]={0};
+    unsigned count[POSSIBILITIES]={0};
+    size_t distinct=0U;
+    for(size_t i=0;i<SAMPLE_COUNT;++i) {
+        calendar_t *sample=NULL;
+        CHECK(calendar_generator_next(generator,&sample,NULL)==0);
+        CHECK(calendar_validate(c,sample)==0);
+        uint64_t fingerprint=calendar_fingerprint(sample);
+        size_t j=0;
+        for(;j<distinct;++j) if(fingerprints[j]==fingerprint)break;
+        if(j==distinct) {
+            CHECK(distinct<POSSIBILITIES);
+            fingerprints[distinct++]=fingerprint;
+        }
+        count[j]++;
+        calendar_destroy(sample);
+    }
+    CHECK(distinct==POSSIBILITIES);
+    double chi_square=0.0,expected=(double)SAMPLE_COUNT/(double)POSSIBILITIES;
+    for(size_t j=0;j<distinct;++j) {
+        double error=(double)count[j]-expected;
+        chi_square+=error*error/expected;
+    }
+    printf("K4 baseline shuffle: %zu/6 distinct, chi-square(5 df)=%.3f over %d samples\n",
+           distinct,chi_square,SAMPLE_COUNT);
+    /* A wide deterministic smoke bound catches severe selection mistakes.
+     * It is NOT a statistical guarantee or a CI performance threshold. */
+    CHECK(chi_square<60.0);
+    calendar_generator_destroy(generator);
+    competition_destroy(c);
+    return EXIT_SUCCESS;
+}
+
+static int recombination_diversity(void) {
+    calendar_test_fixture_t input;
+    CHECK(calendar_test_prepare(&input,8U,14U)==0);
+    competition_t *c=NULL;CHECK(competition_create(&input.input,&c)==0);
+    calendar_options_t options=calendar_options_default();
+    options.method=CALENDAR_METHOD_RECOMBINE;options.seed=UINT32_C(2026);
+    options.moves_per_sample=24U;
+    calendar_generator_t *generator=NULL;
+    CHECK(calendar_generator_create(c,&options,&generator)==0);
+    enum { SAMPLES=250 };
+    uint64_t seen[SAMPLES];size_t distinct=0U;
+    uint64_t partial_moves=0U,three_moves=0U;
+    for(size_t i=0;i<SAMPLES;++i) {
+        calendar_t *sample=NULL;
+        calendar_diagnostics_t stats;
+        CHECK(calendar_generator_next(generator,&sample,&stats)==0);
+        CHECK(calendar_validate(c,sample)==0);
+        uint64_t hash=calendar_fingerprint(sample);
+        size_t j=0;
+        for(;j<distinct;++j) if(seen[j]==hash)break;
+        if(j==distinct) seen[distinct++]=hash;
+        partial_moves+=stats.two_round_partial_moves;
+        three_moves+=stats.three_round_moves;
+        calendar_destroy(sample);
+    }
+    printf("K8 recombination: %zu/%d distinct observed, %" PRIu64
+           " proper 2-round moves, %" PRIu64 " 3-round moves\n",
+           distinct,SAMPLES,partial_moves,three_moves);
+    CHECK(distinct>1U && partial_moves+three_moves>0U);
+    calendar_generator_destroy(generator);
+    competition_destroy(c);
+    return EXIT_SUCCESS;
+}
+int main(void) {
+    CHECK(small_exact_reference()==0);
+    CHECK(recombination_diversity()==0);
+    return EXIT_SUCCESS;
+}

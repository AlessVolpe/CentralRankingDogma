--- /dev/null
+++ b/include/calendar.h
@@ -0,0 +1,99 @@
+/*
+ * LeaderboardSystem calendar permutation API (milestone 3.0.12).
+ * Copyright (C) 2026 Alessandro Volpe
+ * SPDX-License-Identifier: GPL-3.0-only
+ */
+#ifndef LEADERBOARD_CALENDAR_H
+#define LEADERBOARD_CALENDAR_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include "competition.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct calendar calendar_t;
+typedef struct calendar_generator calendar_generator_t;
+
+typedef enum calendar_method {
+    CALENDAR_METHOD_ROUND_SHUFFLE = 0,
+    CALENDAR_METHOD_RECOMBINE = 1
+} calendar_method_t;
+
+typedef enum calendar_sampling_mode {
+    CALENDAR_SAMPLING_INDEPENDENT = 0,
+    CALENDAR_SAMPLING_CHAIN = 1
+} calendar_sampling_mode_t;
+
+typedef struct calendar_options {
+    calendar_method_t method;
+    calendar_sampling_mode_t sampling_mode;
+    uint32_t seed;
+    size_t moves_per_sample; /* RECOMBINE attempts; SHUFFLE does one pass */
+    bool enable_three_round;
+    size_t three_round_attempts; /* randomized search restarts per 3-round move */
+    size_t three_round_node_limit; /* max candidate placements per restart */
+    size_t chain_warmup_moves; /* extra passes/moves before first CHAIN sample */
+    size_t chain_thinning_moves; /* extra passes/moves before later CHAIN samples */
+} calendar_options_t;
+
+typedef struct calendar_diagnostics {
+    uint64_t two_round_attempts;
+    uint64_t two_round_partial_moves;
+    uint64_t two_round_whole_swaps;
+    uint64_t three_round_attempts;
+    uint64_t three_round_moves;
+    uint64_t three_round_search_exhaustions;
+    uint64_t three_round_nodes;
+    size_t changed_base_rounds; /* unordered matchings vs original */
+    size_t changed_season_rounds;
+} calendar_diagnostics_t;
+
+/* Defaults: recombination, independent mode, explicit seed 5489, 32 moves,
+ * bounded 3-round diversification. Supplying explicit options is preferred
+ * for reproducible experiments. */
+calendar_options_t calendar_options_default(void);
+
+/* Borrows competition until calendar_generator_destroy; the original must
+ * already respect the strict N-1-round opponent cooldown / periodicity.
+ * -ENOTSUP: valid 3.0.11 snapshot incompatible with that stronger contract.
+ * -EINVAL: invalid input/options; -EOVERFLOW: size bounds; -ENOMEM: failure.
+ * On ANY error *out=NULL. Pending scores are permitted. */
+int calendar_generator_create(const competition_t *competition,
+                              const calendar_options_t *options,
+                              calendar_generator_t **out);
+void calendar_generator_destroy(calendar_generator_t *generator);
+
+/* Each successful call returns an independently owned, immutable calendar.
+ * RNG and chain state only advance on success; *out=NULL on failure.
+ * A valid result may equal a previously emitted calendar, including original.
+ * Diagnostics summarize this generation call only. */
+int calendar_generator_next(calendar_generator_t *generator,
+                            calendar_t **out,
+                            calendar_diagnostics_t *diagnostics);
+void calendar_destroy(calendar_t *calendar);
+size_t calendar_round_count(const calendar_t *calendar);
+size_t calendar_team_count(const calendar_t *calendar);
+int calendar_round_matchday(const calendar_t *calendar,
+                            size_t round_index, uint32_t *out_matchday);
+int calendar_fixture_at(const calendar_t *calendar, size_t round_index,
+                        size_t fixture_index, fixture_t *out_fixture);
+
+/* Check the complete schedule independently from the generator: dimensions,
+ * team participation, matchday mapping, directed pair counts and cooldown.
+ * Returns 0 for valid, -EINVAL for invalid, -ENOMEM/-EOVERFLOW on resource
+ * failure. Candidate is interpreted under original's team-index mapping. */
+int calendar_validate(const competition_t *original, const calendar_t *candidate);
+
+/* Stable FNV-1a fingerprint of canonical per-round unordered pairings;
+ * fixture order and home/away orientation are ignored. This is for sampling
+ * diagnostics, NOT collision-proof deduplication. */
+uint64_t calendar_fingerprint(const calendar_t *calendar);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* LEADERBOARD_CALENDAR_H */
diff --git a/src/calendar.c b/src/calendar.c
new file mode 100644
index 0000000..405aea7
--- /dev/null
+++ b/src/calendar.c
@@ -0,0 +1,353 @@
+/*
+ * Periodic fixture calendars and independent validation (3.0.12).
+ * Copyright (C) 2026 Alessandro Volpe
+ * SPDX-License-Identifier: GPL-3.0-only
+ */
+#include "calendar.h"
+#include "calendar_internal.h"
+#include "alloc_internal.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int multiply(size_t a, size_t b, size_t *out) {
+    if (a != 0U && b > SIZE_MAX / a) return -EOVERFLOW;
+    *out = a * b;
+    return 0;
+}
+
+static void *copy_buffer(const void *src, size_t count, size_t element_size) {
+    size_t bytes;
+    if (multiply(count, element_size, &bytes) != 0) return NULL;
+    void *p = leaderboard_alloc_malloc(bytes);
+    if (p != NULL) memcpy(p, src, bytes);
+    return p;
+}
+
+static int same_pair(fixture_t a, fixture_t b) {
+    return (a.home == b.home && a.away == b.away) ||
+           (a.home == b.away && a.away == b.home);
+}
+
+static int same_matching(const fixture_t *a, const fixture_t *b, size_t k) {
+    for (size_t i = 0; i < k; ++i) {
+        bool found = false;
+        for (size_t j = 0; j < k; ++j)
+            if (same_pair(a[i], b[j])) { found = true; break; }
+        if (!found) return 0;
+    }
+    return 1;
+}
+
+calendar_options_t calendar_options_default(void) {
+    calendar_options_t options = {
+        CALENDAR_METHOD_RECOMBINE, CALENDAR_SAMPLING_INDEPENDENT,
+        UINT32_C(5489), 32U, true, 4U, 4000U, 0U, 0U
+    };
+    return options;
+}
+
+void calendar_destroy(calendar_t *c) {
+    if (c == NULL) return;
+    free(c->matchdays);
+    free(c->fixtures);
+    free(c);
+}
+
+size_t calendar_round_count(const calendar_t *c) { return c ? c->round_count : 0U; }
+size_t calendar_team_count(const calendar_t *c) { return c ? c->team_count : 0U; }
+
+int calendar_round_matchday(const calendar_t *c, size_t r, uint32_t *out) {
+    if (c == NULL || out == NULL) return -EINVAL;
+    if (r >= c->round_count) return -ERANGE;
+    *out = c->matchdays[r];
+    return 0;
+}
+int calendar_fixture_at(const calendar_t *c, size_t r, size_t f, fixture_t *out) {
+    if (c == NULL || out == NULL) return -EINVAL;
+    if (r >= c->round_count || f >= c->team_count / 2U) return -ERANGE;
+    *out = c->fixtures[r * (c->team_count / 2U) + f];
+    return 0;
+}
+
+/* Canonical fingerprint: sorted partner of every team for every round. This
+ * ignores both fixture ordering and home/away direction. */
+static uint64_t hash_word(uint64_t h, uint32_t v) {
+    for (unsigned k = 0; k < 4U; ++k) {
+        h ^= (uint8_t)(v >> (8U * k));
+        h *= UINT64_C(1099511628211);
+    }
+    return h;
+}
+uint64_t calendar_fingerprint(const calendar_t *c) {
+    if (c == NULL) return 0U;
+    uint64_t h = UINT64_C(14695981039346656037);
+    h = hash_word(h, (uint32_t)c->team_count);
+    h = hash_word(h, (uint32_t)c->round_count);
+    const size_t k = c->team_count / 2U;
+    for (size_t r = 0; r < c->round_count; ++r) {
+        h = hash_word(h, c->matchdays[r]);
+        for (size_t team = 0; team < c->team_count; ++team) {
+            uint32_t opponent = UINT32_MAX;
+            for (size_t f = 0; f < k; ++f) {
+                fixture_t m = c->fixtures[r*k + f];
+                if (m.home == team) opponent = m.away;
+                if (m.away == team) opponent = m.home;
+            }
+            h = hash_word(h, opponent);
+        }
+    }
+    return h;
+}
+
+/* Validation must not simply trust internal generator invariants. */
+int calendar_validate(const competition_t *source, const calendar_t *c) {
+    if (source == NULL || c == NULL) return -EINVAL;
+    const size_t n = competition_team_count(source);
+    const size_t rcount = competition_round_count(source);
+    if (n < 2U || (n & 1U) || c->team_count != n ||
+        c->round_count != rcount || c->fixtures == NULL || c->matchdays == NULL)
+        return -EINVAL;
+    const size_t period = n - 1U;
+    size_t square, bytes;
+    if (multiply(n, n, &square) != 0 ||
+        multiply(square, sizeof(uint32_t), &bytes) != 0) return -EOVERFLOW;
+    uint32_t *directed = leaderboard_alloc_calloc(square, sizeof(*directed));
+    uint8_t *seen = leaderboard_alloc_calloc(n, sizeof(*seen));
+    const size_t base_rounds = rcount < period ? rcount : period;
+    size_t partner_count;
+    if (multiply(base_rounds, n, &partner_count) != 0 ||
+        partner_count > SIZE_MAX / sizeof(team_index_t)) {
+        free(directed); free(seen); return -EOVERFLOW;
+    }
+    team_index_t *reference = leaderboard_alloc_malloc(partner_count * sizeof(*reference));
+    if (directed == NULL || seen == NULL || reference == NULL) {
+        free(directed); free(seen); free(reference); return -ENOMEM;
+    }
+    int result = 0;
+    const size_t k = n / 2U;
+    for (size_t r = 0; r < rcount; ++r) {
+        uint32_t mapped = 0U;
+        if (competition_round_matchday(source, r, &mapped) != 0 ||
+            mapped != c->matchdays[r]) { result = -EINVAL; break; }
+        memset(seen, 0, n);
+        for (size_t f = 0; f < k; ++f) {
+            fixture_t m = c->fixtures[r*k+f];
+            if (m.home >= n || m.away >= n || m.home == m.away ||
+                seen[m.home] || seen[m.away]) { result = -EINVAL; break; }
+            seen[m.home] = seen[m.away] = 1U;
+            if (r < period) {
+                if (directed[(size_t)m.home*n + m.away] != 0U ||
+                    directed[(size_t)m.away*n + m.home] != 0U) {
+                    result = -EINVAL; break;
+                }
+                reference[r*n+m.home]=m.away;
+                reference[r*n+m.away]=m.home;
+            } else if (reference[(r%period)*n + m.home] != m.away) {
+                result = -EINVAL; break;
+            }
+            if (directed[(size_t)m.home*n + m.away] == UINT32_MAX) {
+                result = -EOVERFLOW; break;
+            }
+            directed[(size_t)m.home*n + m.away]++;
+        }
+        if (result != 0) break;
+    }
+    if (result == 0) {
+        for (size_t r = 0; r < rcount; ++r) {
+            for (size_t f = 0; f < k; ++f) {
+                fixture_t m;
+                if (competition_fixture_at(source, r, f, &m) != 0) {
+                    result = -EINVAL; break;
+                }
+                size_t offset = (size_t)m.home*n + m.away;
+                if (directed[offset] == 0U) { result = -EINVAL; break; }
+                directed[offset]--;
+            }
+            if (result != 0) break;
+        }
+    }
+    if (result == 0) {
+        for (size_t i = 0; i < square; ++i)
+            if (directed[i] != 0U) { result = -EINVAL; break; }
+    }
+    free(directed); free(seen); free(reference);
+    return result;
+}
+
+void calendar_generator_destroy(calendar_generator_t *g) {
+    if (g == NULL) return;
+    free(g->initial_base);
+    free(g->chain_base);
+    free(g->orientation);
+    free(g);
+}
+
+int calendar_generator_create(const competition_t *source,
+                              const calendar_options_t *given,
+                              calendar_generator_t **out) {
+    if (out == NULL) return -EINVAL;
+    *out = NULL;
+    if (source == NULL) return -EINVAL;
+    calendar_options_t options = given ? *given : calendar_options_default();
+    if ((options.method != CALENDAR_METHOD_ROUND_SHUFFLE &&
+         options.method != CALENDAR_METHOD_RECOMBINE) ||
+        (options.sampling_mode != CALENDAR_SAMPLING_INDEPENDENT &&
+         options.sampling_mode != CALENDAR_SAMPLING_CHAIN) ||
+        (options.enable_three_round &&
+         (options.three_round_attempts == 0U ||
+          options.three_round_node_limit == 0U))) return -EINVAL;
+    const size_t n = competition_team_count(source), r = competition_round_count(source);
+    if (n < 2U || (n & 1U) != 0U || r == 0U) return -EINVAL;
+    if (n > UINT32_MAX || r > UINT32_MAX) return -EOVERFLOW;
+    const size_t p = n-1U, b = r < p ? r : p, k = n/2U;
+    size_t base_fixtures, square, orientations, stride = r/p + (r%p != 0U);
+    size_t partner_cells;
+    if (multiply(b,k,&base_fixtures) != 0 ||
+        multiply(b,n,&partner_cells) != 0 ||
+        partner_cells > SIZE_MAX / sizeof(uint32_t) ||
+        multiply(n,n,&square) != 0 ||
+        multiply(square,stride,&orientations) != 0 ||
+        base_fixtures > SIZE_MAX / sizeof(fixture_t)) return -EOVERFLOW;
+    calendar_generator_t *g = leaderboard_alloc_calloc(1U, sizeof(*g));
+    if (g == NULL) return -ENOMEM;
+    g->source=source; g->options=options;g->n=n;g->rounds=r;
+    g->period=p;g->base_rounds=b;g->fixtures_per_round=k;
+    g->frequency_group_split = r % p == 0U ? b : r % p;
+    g->orientation_stride=stride;
+    g->initial_base=leaderboard_alloc_malloc(base_fixtures*sizeof(fixture_t));
+    g->chain_base=leaderboard_alloc_malloc(base_fixtures*sizeof(fixture_t));
+    g->orientation=leaderboard_alloc_calloc(orientations,sizeof(*g->orientation));
+    if (g->initial_base == NULL || g->chain_base == NULL || g->orientation == NULL) {
+        calendar_generator_destroy(g); return -ENOMEM;
+    }
+    int status = 0;
+    uint32_t *base_partner = leaderboard_alloc_malloc(partner_cells*sizeof(*base_partner));
+    if (base_partner == NULL) { calendar_generator_destroy(g); return -ENOMEM; }
+    for (size_t i = 0; i < partner_cells; ++i) base_partner[i] = UINT32_MAX;
+    for (size_t ri = 0; ri < r; ++ri) {
+        for (size_t f = 0; f < k; ++f) {
+            fixture_t m;
+            if (competition_fixture_at(source,ri,f,&m) != 0 ||
+                m.home >= n || m.away >= n || m.home == m.away) {
+                status = -EINVAL; goto invalid;
+            }
+            if (ri < b) {
+                g->initial_base[ri*k+f]=m;
+                if (base_partner[ri*n+m.home] != UINT32_MAX ||
+                    base_partner[ri*n+m.away] != UINT32_MAX) {
+                    status = -ENOTSUP; goto invalid;
+                }
+                base_partner[ri*n+m.home]=m.away;
+                base_partner[ri*n+m.away]=m.home;
+                /* All base matchings must be pairwise edge-disjoint. */
+                for (size_t prev=0;prev<ri;++prev)
+                    if (base_partner[prev*n+m.home] == m.away) {
+                        status = -ENOTSUP;goto invalid;
+                    }
+            } else if (base_partner[(ri%p)*n+m.home] != m.away) {
+                status = -ENOTSUP;goto invalid;
+            }
+            size_t low = m.home < m.away ? m.home : m.away;
+            size_t high = m.home < m.away ? m.away : m.home;
+            g->orientation[(low*n+high)*stride+ri/p] = (uint8_t)(m.home == low);
+        }
+    }
+    memcpy(g->chain_base,g->initial_base,base_fixtures*sizeof(fixture_t));
+    mtwister_seed_standard(&g->rng,options.seed);
+invalid:
+    free(base_partner);
+    if (status != 0) { calendar_generator_destroy(g); return status; }
+    *out=g;return 0;
+}
+
+static int materialize(const calendar_generator_t *g, const fixture_t *base,
+                       calendar_t **out) {
+    calendar_t *c = leaderboard_alloc_calloc(1U,sizeof(*c));
+    if (c == NULL) return -ENOMEM;
+    c->team_count=g->n; c->round_count=g->rounds;
+    size_t count=g->rounds*g->fixtures_per_round;
+    c->matchdays=leaderboard_alloc_malloc(g->rounds*sizeof(*c->matchdays));
+    c->fixtures=leaderboard_alloc_malloc(count*sizeof(*c->fixtures));
+    if (c->matchdays==NULL || c->fixtures==NULL) { calendar_destroy(c);return -ENOMEM; }
+    for (size_t r=0;r<g->rounds;++r) {
+        uint32_t day;
+        if (competition_round_matchday(g->source,r,&day) != 0) {
+            calendar_destroy(c);return -EINVAL;
+        }
+        c->matchdays[r]=day;
+        for (size_t f=0;f<g->fixtures_per_round;++f) {
+            fixture_t m=base[(r%g->period)*g->fixtures_per_round+f];
+            size_t low=m.home < m.away ? m.home : m.away;
+            size_t high=m.home < m.away ? m.away : m.home;
+            uint8_t low_at_home=g->orientation[(low*g->n+high)*g->orientation_stride+r/g->period];
+            c->fixtures[r*g->fixtures_per_round+f]=
+                low_at_home ? (fixture_t){(team_index_t)low,(team_index_t)high}
+                            : (fixture_t){(team_index_t)high,(team_index_t)low};
+        }
+    }
+    *out=c;return 0;
+}
+
+int calendar_generator_next(calendar_generator_t *g, calendar_t **out,
+                            calendar_diagnostics_t *diagnostics) {
+    if (out == NULL) return -EINVAL;
+    *out = NULL;
+    if (g == NULL) return -EINVAL;
+    calendar_diagnostics_t stats={0};
+    size_t count=g->base_rounds*g->fixtures_per_round;
+    const fixture_t *start = g->options.sampling_mode == CALENDAR_SAMPLING_CHAIN
+                             ? g->chain_base : g->initial_base;
+    fixture_t *base=copy_buffer(start,count,sizeof(*base));
+    if (base == NULL) return -ENOMEM;
+    mtwister_t rng=g->rng; /* state is failure-atomic */
+    int error=0;
+    if (g->options.method == CALENDAR_METHOD_ROUND_SHUFFLE) {
+        size_t passes = 1U;
+        if (g->options.sampling_mode == CALENDAR_SAMPLING_CHAIN) {
+            size_t extra = g->generated ? g->options.chain_thinning_moves
+                                        : g->options.chain_warmup_moves;
+            if (extra == SIZE_MAX) { free(base);return -EOVERFLOW; }
+            passes += extra;
+        }
+        for (size_t pass = 0; pass < passes; ++pass)
+            calendar_shuffle_base(g,&rng,base);
+    } else {
+        size_t moves=g->options.moves_per_sample;
+        if (g->options.sampling_mode == CALENDAR_SAMPLING_CHAIN) {
+            size_t extra = g->generated ? g->options.chain_thinning_moves
+                                        : g->options.chain_warmup_moves;
+            if (moves > SIZE_MAX-extra) { free(base);return -EOVERFLOW; }
+            moves+=extra;
+        }
+        error=calendar_recombine_base(g,&rng,base,moves,&stats);
+    }
+    if (error == 0) {
+        for (size_t i=0;i<g->base_rounds;++i) {
+            if (!same_matching(base+i*g->fixtures_per_round,
+                               g->initial_base+i*g->fixtures_per_round,
+                               g->fixtures_per_round)) {
+                stats.changed_base_rounds++;
+                /* Each base position appears either floor(R/P) or ceil(R/P) times. */
+                stats.changed_season_rounds += g->rounds/g->period +
+                    (i < (g->rounds%g->period) ? 1U : 0U);
+            }
+        }
+        calendar_t *c=NULL;
+        error=materialize(g,base,&c);
+        if (error == 0) {
+            error=calendar_validate(g->source,c);
+            if (error == 0) {
+                if (g->options.sampling_mode == CALENDAR_SAMPLING_CHAIN)
+                    memcpy(g->chain_base,base,count*sizeof(*base));
+                g->rng=rng;g->generated=true;
+                *out=c;
+                if (diagnostics != NULL) *diagnostics=stats;
+            } else calendar_destroy(c);
+        }
+    }
+    free(base);
+    return error;
+}
diff --git a/src/calendar_recombine.c b/src/calendar_recombine.c
new file mode 100644
index 0000000..915255a
--- /dev/null
+++ b/src/calendar_recombine.c
@@ -0,0 +1,236 @@
+/*
+ * Constrained edge recolorings of periodic one-factorizations (3.0.12).
+ * Copyright (C) 2026 Alessandro Volpe
+ * SPDX-License-Identifier: GPL-3.0-only
+ */
+#include "calendar_internal.h"
+#include "alloc_internal.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int same_pair(fixture_t a,fixture_t b) {
+    return (a.home==b.home && a.away==b.away) ||
+           (a.home==b.away && a.away==b.home);
+}
+static int same_matching(const fixture_t *a,const fixture_t *b,size_t count) {
+    for(size_t i=0;i<count;++i) {
+        int found=0;
+        for(size_t j=0;j<count;++j) if(same_pair(a[i],b[j])) {found=1;break;}
+        if(!found) return 0;
+    }
+    return 1;
+}
+
+/* Select k distinct positions from an equally frequent group. */
+static int select_positions(const calendar_generator_t *g,mtwister_t *rng,
+                            size_t requested,size_t positions[3]) {
+    const size_t split=g->frequency_group_split;
+    const size_t first_length=split,second_length=g->base_rounds-split;
+    int first_ok=first_length>=requested,second_ok=second_length>=requested;
+    if(!first_ok && !second_ok) return 0;
+    size_t start=0U, count=first_length;
+    if(!first_ok || (second_ok && calendar_random_bounded(rng,2U)==1U)) {
+        start=split;count=second_length;
+    }
+    for(size_t i=0;i<requested;++i) {
+        size_t pick;
+        int repeat;
+        do {
+            pick=start+calendar_random_bounded(rng,(uint32_t)count);
+            repeat=0;
+            for(size_t j=0;j<i;++j) if(positions[j]==pick) {repeat=1;break;}
+        } while(repeat);
+        positions[i]=pick;
+    }
+    return 1;
+}
+
+/* In the union of two perfect matchings each vertex has exactly one edge
+ * of each color. Hence its components are alternating even cycles. */
+static int two_round_move(const calendar_generator_t *g,mtwister_t *rng,
+                          fixture_t *base,calendar_diagnostics_t *stats,
+                          team_index_t *partner_a,team_index_t *partner_b,
+                          size_t *components,size_t *queue) {
+    size_t positions[3];
+    if(!select_positions(g,rng,2U,positions)) return 0;
+    ++stats->two_round_attempts;
+    const size_t n=g->n,k=g->fixtures_per_round;
+    fixture_t *a=base+positions[0]*k,*b=base+positions[1]*k;
+    for(size_t i=0;i<n;++i) {partner_a[i]=UINT32_MAX;partner_b[i]=UINT32_MAX;components[i]=SIZE_MAX;}
+    for(size_t i=0;i<k;++i) {
+        partner_a[a[i].home]=a[i].away;partner_a[a[i].away]=a[i].home;
+        partner_b[b[i].home]=b[i].away;partner_b[b[i].away]=b[i].home;
+    }
+    size_t count=0U;
+    for(size_t v=0;v<n;++v) if(components[v]==SIZE_MAX) {
+        size_t head=0U,tail=0U;
+        queue[tail++]=v;components[v]=count;
+        while(head<tail) {
+            size_t x=queue[head++];
+            size_t nb[2]={partner_a[x],partner_b[x]};
+            for(size_t i=0;i<2U;++i) if(components[nb[i]]==SIZE_MAX) {
+                components[nb[i]]=count;queue[tail++]=nb[i];
+            }
+        }
+        ++count;
+    }
+    if(count==0U) return 0;
+    size_t chosen=calendar_random_bounded(rng,(uint32_t)count);
+    /* Each component contributes the same number of edges to each round. */
+    size_t left=0U,right=0U;
+    for(size_t i=0;i<k;++i) if(components[a[i].home]==chosen) queue[left++]=i;
+    /* Reuse partner_a as temporary right-side indices: n >= k. */
+    for(size_t i=0;i<k;++i) if(components[b[i].home]==chosen) partner_a[right++]=(team_index_t)i;
+    if(left!=right) return -EINVAL;
+    for(size_t i=0;i<left;++i) {
+        fixture_t tmp=a[queue[i]];
+        a[queue[i]]=b[partner_a[i]];
+        b[partner_a[i]]=tmp;
+    }
+    if(count>1U) ++stats->two_round_partial_moves;
+    else ++stats->two_round_whole_swaps;
+    return 0;
+}
+
+/* Coloring the 3-factor union is an exact-cover/3-edge-coloring problem.
+ * Each vertex must use each of three colors exactly once. Iterative bounded
+ * DFS avoids stack exhaustion on large league sizes. */
+static int three_round_search(const calendar_generator_t *g, mtwister_t *rng,
+                              fixture_t *base,size_t slots[3],
+                              calendar_diagnostics_t *stats,
+                              fixture_t *edges,fixture_t *result,
+                              uint8_t *used,uint8_t *choice,
+                              uint8_t *assigned,uint8_t *starts,
+                              size_t *order) {
+    const size_t n=g->n,k=g->fixtures_per_round,e=3U*k;
+    for(size_t a=0;a<3U;++a)
+        memcpy(edges+a*k,base+slots[a]*k,k*sizeof(*edges));
+    for(size_t a=0;a<e;++a) order[a]=a;
+    for(size_t a=e;a>1U;--a) {
+        size_t j=calendar_random_bounded(rng,(uint32_t)a);
+        size_t tmp=order[a-1U];order[a-1U]=order[j];order[j]=tmp;
+    }
+    memset(used,0,n);
+    memset(choice,0,e);
+    for(size_t a=0;a<e;++a) starts[a]=(uint8_t)calendar_random_bounded(rng,3U);
+    size_t depth=0U,nodes=0U;
+    while(1) {
+        if(depth==e) {
+            size_t counts[3]={0U,0U,0U};
+            for(size_t i=0;i<e;++i) {
+                uint8_t color=assigned[i];
+                result[color*k+counts[color]++]=edges[order[i]];
+            }
+            /* Reject all three-round permutations of original groups. */
+            int trivial=1;
+            for(size_t i=0;i<3U;++i) {
+                int found=0;
+                for(size_t j=0;j<3U;++j)
+                    if(same_matching(result+i*k,base+slots[j]*k,k)) {found=1;break;}
+                if(!found) {trivial=0;break;}
+            }
+            if(!trivial) {
+                for(size_t i=0;i<3U;++i)
+                    memcpy(base+slots[i]*k,result+i*k,k*sizeof(*result));
+                stats->three_round_nodes+=nodes;
+                return 1;
+            }
+            /* Continue searching after trivial factorizations. */
+        }
+        if(depth==e || choice[depth]==3U) {
+            if(depth==0U) {stats->three_round_nodes+=nodes;return 0;}
+            if(depth<e) choice[depth]=0U;
+            --depth;
+            fixture_t m=edges[order[depth]];
+            uint8_t bit=(uint8_t)(1U<<assigned[depth]);
+            used[m.home]=(uint8_t)(used[m.home]&~bit);
+            used[m.away]=(uint8_t)(used[m.away]&~bit);
+            continue;
+        }
+        if(nodes==g->options.three_round_node_limit) {
+            stats->three_round_nodes+=nodes;
+            ++stats->three_round_search_exhaustions;
+            return 0;
+        }
+        uint8_t color=(uint8_t)((starts[depth]+choice[depth]++)%3U);
+        ++nodes;
+        fixture_t m=edges[order[depth]];
+        uint8_t bit=(uint8_t)(1U<<color);
+        if((used[m.home]&bit)!=0U || (used[m.away]&bit)!=0U) continue;
+        used[m.home]|=bit;used[m.away]|=bit;
+        assigned[depth]=color;
+        ++depth;
+        if(depth<e) choice[depth]=0U;
+    }
+}
+
+int calendar_recombine_base(const calendar_generator_t *g,
+                            mtwister_t *rng, fixture_t *base,
+                            size_t moves,calendar_diagnostics_t *stats) {
+    if(moves==0U) return 0;
+    const size_t n=g->n,k=g->fixtures_per_round;
+    /* Allocate all move workspace through the injectable allocation layer,
+     * before any attempt; generator/PRNG state commit is caller-controlled. */
+    team_index_t *a=leaderboard_alloc_malloc(n*sizeof(*a));
+    team_index_t *b=leaderboard_alloc_malloc(n*sizeof(*b));
+    size_t *components=leaderboard_alloc_malloc(n*sizeof(*components));
+    size_t *queue=leaderboard_alloc_malloc(n*sizeof(*queue));
+    if(a==NULL || b==NULL || components==NULL || queue==NULL) {
+        free(a);free(b);free(components);free(queue);return -ENOMEM;
+    }
+    if(k>SIZE_MAX/3U) {
+        free(a);free(b);free(components);free(queue);return -EOVERFLOW;
+    }
+    size_t triple_size=3U*k;
+    fixture_t *edges=NULL,*result=NULL;
+    uint8_t *used=NULL,*choice=NULL,*assigned=NULL,*starts=NULL;
+    size_t *order=NULL;
+    int triple_possible = g->options.enable_three_round &&
+        (g->frequency_group_split>=3U || g->base_rounds-g->frequency_group_split>=3U);
+    if(triple_possible) {
+        if(triple_size>UINT32_MAX ||
+           triple_size>SIZE_MAX/sizeof(fixture_t) ||
+           triple_size>SIZE_MAX/sizeof(size_t)) {
+            free(a);free(b);free(components);free(queue);return -EOVERFLOW;
+        }
+        edges=leaderboard_alloc_malloc(triple_size*sizeof(*edges));
+        result=leaderboard_alloc_malloc(triple_size*sizeof(*result));
+        used=leaderboard_alloc_malloc(n*sizeof(*used));
+        choice=leaderboard_alloc_malloc(triple_size*sizeof(*choice));
+        assigned=leaderboard_alloc_malloc(triple_size*sizeof(*assigned));
+        starts=leaderboard_alloc_malloc(triple_size*sizeof(*starts));
+        order=leaderboard_alloc_malloc(triple_size*sizeof(*order));
+        if(edges==NULL || result==NULL || used==NULL || choice==NULL ||
+           assigned==NULL || starts==NULL || order==NULL) {
+            free(a);free(b);free(components);free(queue);
+            free(edges);free(result);free(used);free(choice);
+            free(assigned);free(starts);free(order);return -ENOMEM;
+        }
+    }
+    int status=0;
+    for(size_t move=0;move<moves;++move) {
+        /* A three-round move is selected in one out of four attempts; the
+         * remaining moves are fast alternating-cycle recolorings. */
+        int triple=triple_possible && calendar_random_bounded(rng,4U)==0U;
+        if(triple) {
+            size_t slots[3];
+            ++stats->three_round_attempts;
+            if(!select_positions(g,rng,3U,slots)) continue;
+            for(size_t retry=0;retry<g->options.three_round_attempts;++retry) {
+                if(three_round_search(g,rng,base,slots,stats,edges,result,used,
+                                      choice,assigned,starts,order)) {
+                    ++stats->three_round_moves;break;
+                }
+            }
+        } else {
+            status=two_round_move(g,rng,base,stats,a,b,components,queue);
+            if(status!=0) break;
+        }
+    }
+    free(a);free(b);free(components);free(queue);
+    free(edges);free(result);free(used);free(choice);
+    free(assigned);free(starts);free(order);
+    return status;
+}
diff --git a/src/calendar_shuffle.c b/src/calendar_shuffle.c
new file mode 100644
index 0000000..39202ac
--- /dev/null
+++ b/src/calendar_shuffle.c
@@ -0,0 +1,37 @@
+/*
+ * Unbiased bounded MT19937 draws and period-class Fisher-Yates shuffle.
+ * Copyright (C) 2026 Alessandro Volpe
+ * SPDX-License-Identifier: GPL-3.0-only
+ */
+#include "calendar_internal.h"
+
+/* Let M=2^32 and t=M mod b. Reject [0,t), then the remaining
+ * M-t integers have equal-sized residue classes modulo b. */
+uint32_t calendar_random_bounded(mtwister_t *rng, uint32_t bound) {
+    if (bound <= 1U) return 0U;
+    const uint32_t threshold = (uint32_t)(0U - bound) % bound;
+    uint32_t x;
+    do { x = mtwister_next_u32(rng); } while (x < threshold);
+    return x % bound;
+}
+
+void calendar_shuffle_group(mtwister_t *rng, fixture_t *base, size_t first,
+                            size_t length, size_t k) {
+    for (size_t i = length; i > 1U; --i) {
+        size_t j = calendar_random_bounded(rng, (uint32_t)i);
+        size_t left=(first+i-1U)*k,right=(first+j)*k;
+        for (size_t f=0;f<k;++f) {
+            fixture_t temporary=base[left+f];
+            base[left+f]=base[right+f];
+            base[right+f]=temporary;
+        }
+    }
+}
+
+void calendar_shuffle_base(const calendar_generator_t *g,
+                           mtwister_t *rng, fixture_t *base) {
+    const size_t split=g->frequency_group_split;
+    calendar_shuffle_group(rng,base,0U,split,g->fixtures_per_round);
+    calendar_shuffle_group(rng,base,split,g->base_rounds-split,
+                           g->fixtures_per_round);
+}

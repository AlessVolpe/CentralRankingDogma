{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlessVolpe/CentralRankingDogma/blob/master/schemas/leaderboard-cli-v1-request.schema.json",
  "title": "Central Ranking Dogma JSON CLI v1 request",
  "description": "JSON CLI v1 request contract; implemented by the native crd-json executable.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "validate"
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "competition": {
          "$ref": "#/$defs/competition"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "operation",
        "competition"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "generate"
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "competition": {
          "$ref": "#/$defs/competition"
        },
        "generator": {
          "$ref": "#/$defs/generator"
        },
        "sample_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "operation",
        "competition",
        "generator",
        "sample_index"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "resolve"
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "competition": {
          "$ref": "#/$defs/competition"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "calendar": {
          "$ref": "#/$defs/calendar_selector"
        },
        "ranking_backend": {
          "$ref": "#/$defs/ranking_backend"
        },
        "rules": {
          "$ref": "#/$defs/rules"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "operation",
        "competition",
        "scope",
        "calendar"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "simulate"
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "competition": {
          "$ref": "#/$defs/competition"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "generator": {
          "$ref": "#/$defs/generator"
        },
        "requested_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_generation_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "statistics": {
          "$ref": "#/$defs/statistics"
        },
        "ranking_backend": {
          "$ref": "#/$defs/ranking_backend"
        },
        "rules": {
          "$ref": "#/$defs/rules"
        },
        "unique_only": {
          "type": "boolean"
        },
        "track_uniqueness": {
          "type": "boolean"
        },
        "uniqueness_memory_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "progress_every_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "emit_progress": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "operation",
        "competition",
        "scope",
        "generator",
        "requested_samples",
        "max_generation_attempts",
        "statistics"
      ]
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "positive_u32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home_uuid": {
          "$ref": "#/$defs/uuid"
        },
        "away_uuid": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "home_uuid",
        "away_uuid"
      ]
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "uuid",
        "name"
      ],
      "description": "Team name maxLength counts code points; a separate 255 UTF-8 byte limit applies."
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serie_a_matchday": {
          "$ref": "#/$defs/positive_u32"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixture"
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "serie_a_matchday",
        "fixtures"
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team_uuid": {
          "$ref": "#/$defs/uuid"
        },
        "serie_a_matchday": {
          "$ref": "#/$defs/positive_u32"
        },
        "points_tenths": {
          "$ref": "#/$defs/u32"
        },
        "status": {
          "type": "string",
          "enum": [
            "FINAL",
            "PENDING"
          ]
        }
      },
      "required": [
        "team_uuid",
        "serie_a_matchday",
        "points_tenths",
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PENDING"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "points_tenths": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/team"
          },
          "minItems": 2,
          "maxItems": 20
        },
        "rounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/round"
          },
          "minItems": 1,
          "maxItems": 80
        },
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/score"
          },
          "minItems": 2,
          "maxItems": 1600
        }
      },
      "required": [
        "teams",
        "rounds",
        "scores"
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal_thresholds_tenths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u32"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "post_eighth_step_tenths": {
          "$ref": "#/$defs/positive_u32"
        },
        "limit_victory_enabled": {
          "type": "boolean"
        },
        "limit_victory_max_gap_tenths": {
          "$ref": "#/$defs/u32"
        },
        "limit_victory_include_subthreshold": {
          "type": "boolean"
        },
        "limit_draw_enabled": {
          "type": "boolean"
        },
        "limit_draw_min_gap_tenths": {
          "$ref": "#/$defs/u32"
        },
        "limit_draw_include_subthreshold": {
          "type": "boolean"
        },
        "home_advantage_enabled": {
          "type": "boolean"
        },
        "home_advantage_tenths": {
          "$ref": "#/$defs/u32"
        },
        "home_advantage_exclude_final_cycle": {
          "type": "boolean"
        }
      },
      "required": [
        "goal_thresholds_tenths",
        "post_eighth_step_tenths",
        "limit_victory_enabled",
        "limit_victory_max_gap_tenths",
        "limit_victory_include_subthreshold",
        "limit_draw_enabled",
        "limit_draw_min_gap_tenths",
        "limit_draw_include_subthreshold",
        "home_advantage_enabled",
        "home_advantage_tenths",
        "home_advantage_exclude_final_cycle"
      ],
      "description": "Complete explicit match_rules_t. Omit rules entirely to use match_rules_default. Further ascending/threshold checks are semantic."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "shuffle",
            "recombine"
          ]
        },
        "sampling_mode": {
          "type": "string",
          "enum": [
            "independent",
            "chain"
          ]
        },
        "seed": {
          "$ref": "#/$defs/u32"
        },
        "moves_per_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "enable_three_round": {
          "type": "boolean"
        },
        "three_round_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "three_round_node_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "chain_warmup_moves": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "chain_thinning_moves": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "method",
        "sampling_mode",
        "seed"
      ]
    },
    "calendar_selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "original"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "generated"
            },
            "generator": {
              "$ref": "#/$defs/effective_generator"
            },
            "sample_index": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "expected_engine_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._+:-]+$"
            }
          },
          "required": [
            "kind",
            "generator",
            "sample_index",
            "expected_engine_id"
          ]
        }
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "FULL_SEASON",
        "FINALIZED_PREFIX"
      ]
    },
    "ranking_backend": {
      "type": "string",
      "enum": [
        "heapsort",
        "avl"
      ]
    },
    "statistics": {
      "type": "string",
      "enum": [
        "basic",
        "advanced",
        "both"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "effective_generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "shuffle",
            "recombine"
          ]
        },
        "sampling_mode": {
          "type": "string",
          "enum": [
            "independent",
            "chain"
          ]
        },
        "seed": {
          "$ref": "#/$defs/u32"
        },
        "moves_per_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "enable_three_round": {
          "type": "boolean"
        },
        "three_round_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "three_round_node_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "chain_warmup_moves": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "chain_thinning_moves": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "method",
        "sampling_mode",
        "seed",
        "moves_per_sample",
        "enable_three_round",
        "three_round_attempts",
        "three_round_node_limit",
        "chain_warmup_moves",
        "chain_thinning_moves"
      ]
    }
  }
}
